{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darkpath-server",
  "main": "worker.js",
  "compatibility_date": "2026-10-16",

  "durable_objects": {
    "bindings": [
      {
        "name": "DARK_PATH_ROOMS",
        "class_name": "DarkPathRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DarkPathRoom"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
